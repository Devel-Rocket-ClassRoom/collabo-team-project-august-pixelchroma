  m_Script: {fileID: 11500000, guid: 039f16695057b1042988924648e3e902, type: 3}
  m_Name: LobbyTalk_Main
  m_EditorClassIdentifier: Assembly-CSharp::LobbyTalkData
  greetingLines:
  - "\uC9C0\uD718\uAD00\uB2D8, \uCD9C\uACA9 \uC900\uBE44\uAC00 \uC644\uB8CC\uB410\uC2B5\uB2C8\uB2E4."
  - "\uC624\uC168\uC2B5\uB2C8\uAE4C, \uAD6D\uC7A5\uB2D8. \uC624\uB298 \uC77C\uC815\uC740
    \uC81C\uAC00 \uC804\uBD80 \uAE30\uC5B5\uD574 \uB450\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uB300\uAE30 \uC911\uC778 \uC758\uB8B0\uAC00 \uC788\uC2B5\uB2C8\uB2E4. \uD655\uC778\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  touchLines:
  - "\u2026\uC5C5\uBB34 \uC911\uC785\uB2C8\uB2E4, \uAD6D\uC7A5\uB2D8. \n\uC6A9\uAC74\uC774
    \uC788\uC73C\uC2DC\uBA74 \uB9D0\uB85C \uD574 \uC8FC\uC2ED\uC2DC\uC624."
  - "SAFE\uBC18 \uC544\uC774\uB4E4\uC740 \uC624\uB298\uB3C4 \uBB34\uC0AC\uD569\uB2C8\uB2E4.
    \n\uC801\uC5B4\uB3C4 \uC9C0\uAE08\uAE4C\uC9C0\uB294\uC694."
  - "\uCD9C\uACA9 \uC804\uC5D0\uB294 \uC704\uD611 \uBC94\uC704\uBD80\uD130 \uD655\uC778\uD558\uC2ED\uC2DC\uC624.
    \n\uC81C\uAC00 \uBA87 \uBC88\uC774\uACE0 \uB9D0\uC500\uB4DC\uB9B4 \uAC81\uB2C8\uB2E4."
  - "\uBCF4\uCDA9\uC218\uC5C5 \uC900\uBE44\uB294 \uD558\uC168\uC2B5\uB2C8\uAE4C?
    \n\uAD50\uC0AC \uC5C5\uBB34\uB3C4 \uAD6D\uC7A5\uB2D8 \uBAAB\uC785\uB2C8\uB2E4."
  - "CSIA \uCABD\uC5D0\uC11C \uB610 \uD611\uC870 \uC694\uCCAD\uC774 \uC654\uC2B5\uB2C8\uB2E4.\n\n
    \u2026\uAC00\uB2A5\uD558\uBA74 \uBB34\uC2DC\uD558\uACE0 \uC2F6\uAD70\uC694."
  - "\uC81C \uB2A5\uB825\uC774\uC694? \uAE30\uC5B5\uC744 \uC800\uC7A5\uD558\uACE0
    \uBD88\uB7EC\uC624\uB294 \uAC81\uB2C8\uB2E4. \n\uAD6D\uC7A5\uB2D8 \uC2E4\uC218\uB3C4
    \uC804\uBD80\uC694."
  - "\uCEE4\uD53C\uB294 \uC774\uBBF8 \uCC45\uC0C1 \uC704\uC5D0 \uB450\uC5C8\uC2B5\uB2C8\uB2E4.
    \n\uC2DD\uAE30 \uC804\uC5D0 \uB4DC\uC2ED\uC2DC\uC624."
  - "\uAD6D\uC7A5\uB2D8\uC774 \uC544\uC774\uB4E4\uC744 \uCC59\uAE30\uB294 \uBAA8\uC2B5\uC740\u2026
    \n\uB098\uC058\uC9C0 \uC54A\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4."
  playInOrder: 0
  charactersPerSecond: 20
  touchCooldown: 0.5
