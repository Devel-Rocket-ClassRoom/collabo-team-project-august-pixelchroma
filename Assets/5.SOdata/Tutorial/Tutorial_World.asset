    - id: 9
      speakerName: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
      dialogueText: "J\uC0AC\uB9BD\uACE0 SAFE\uBC18. \uAD6D\uC7A5\uB2D8\uC774 \uBCF4\uCDA9\uC218\uC5C5
        \uAD50\uC0AC\uB85C \uB2F4\uB2F9\uD558\uC2DC\uAC8C \uB420, \uB2A5\uB825\uC790
        \uD559\uC0DD \uC5EC\uC12F \uBA85\uC785\uB2C8\uB2E4."
      characterIllust: {fileID: 0}
      BackGroundSprit: {fileID: 21300000, guid: 42afc4d183172ea4bb375c2b4da312d0, type: 3}
      showChatUI: 1
      EffectSound: {fileID: 0}
