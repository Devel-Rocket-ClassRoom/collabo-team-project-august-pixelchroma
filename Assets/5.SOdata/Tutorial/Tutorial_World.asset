  groups:
  - id: 0
    GroupName: "\uCCAB \uCD9C\uADFC"
    entries:
    - id: 0
      speakerName: "\uB098"
      dialogueText: "\uAD6D\uBB34\uCD1D\uB9AC \uBA85\uC758\uC758 \uC784\uBA85\uC7A5.
        \uC624\uB298\uBD80\uD130 \uB0B4 \uC9C1\uD568\uC740 '\uC774\uC0C1\uAD00\uB9AC\uAD6D
        \uAD6D\uC7A5'\uC774\uB2E4."
      characterIllust: {fileID: 0}
      BackGroundSprit: {fileID: 21300000, guid: 42afc4d183172ea4bb375c2b4da312d0, type: 3}
      showChatUI: 1
      EffectSound: {fileID: 0}
      seVolune: 1
      choices: []
      Char1:
        CharacterPNG: {fileID: 0}
        CharacterPos: {x: 0, y: -100}
        CharacterScale: 1
        CharacterRotation: 0
        moveDuration: 0.5
      Char2:
        CharacterPNG: {fileID: 0}
        CharacterPos: {x: 0, y: -100}
        CharacterScale: 1
        CharacterRotation: 0
        moveDuration: 0.5
      nextIndexOverride: -1
      effectVideoClip: {fileID: 0}
    - id: 1
      speakerName: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
      dialogueText: "\uAD6D\uC7A5\uB2D8, \uC774\uC0C1\uAD00\uB9AC\uAD6D AMA \uC11C\uAE30
        \uACB8 \uBE44\uC11C \uD0A4\uD0C0\uB178 \uC720\uD0A4\uC785\uB2C8\uB2E4. \uC624\uB298\uBD80\uD130
        \uAD6D\uC7A5\uB2D8\uC758 \uC5C5\uBB34\uB97C \uBCF4\uC88C\uD569\uB2C8\uB2E4."
      characterIllust: {fileID: 0}
      BackGroundSprit: {fileID: 21300000, guid: 42afc4d183172ea4bb375c2b4da312d0, type: 3}
      showChatUI: 1
      EffectSound: {fileID: 0}
      seVolune: 1
      choices: []
      Char1:
        CharacterPNG: {fileID: 0}
        CharacterPos: {x: 0, y: -100}
        CharacterScale: 1
        CharacterRotation: 0
        moveDuration: 0.5
      Char2:
        CharacterPNG: {fileID: 0}
        CharacterPos: {x: 0, y: -100}
        CharacterScale: 1
        CharacterRotation: 0
        moveDuration: 0.5
      nextIndexOverride: -1
      effectVideoClip: {fileID: 0}
    - id: 2
      speakerName: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
      dialogueText: "\uBD80\uC784 \uCCAB\uB0A0\uC774\uB2C8 \uAE30\uBCF8 \uBE0C\uB9AC\uD551\uBD80\uD130
        \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4. \uBA54\uBAA8\uB294 \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4.
        \uD544\uC694\uD55C \uAC74 \uC81C\uAC00 \uC804\uBD80 \uAE30\uC5B5\uD574 \uB450\uB2C8\uAE4C\uC694."
      characterIllust: {fileID: 0}
      BackGroundSprit: {fileID: 21300000, guid: 42afc4d183172ea4bb375c2b4da312d0, type: 3}
      showChatUI: 1
      EffectSound: {fileID: 0}
      seVolune: 1
      choices: []
      Char1:
        CharacterPNG: {fileID: 0}
        CharacterPos: {x: 0, y: -100}
        CharacterScale: 1
        CharacterRotation: 0
        moveDuration: 0.5
      Char2:
        CharacterPNG: {fileID: 0}
        CharacterPos: {x: 0, y: -100}
        CharacterScale: 1
        CharacterRotation: 0
        moveDuration: 0.5
      nextIndexOverride: -1
      effectVideoClip: {fileID: 0}
  - id: 1
    GroupName: "\uC138\uACC4\uAD00 \uBE0C\uB9AC\uD551"
    entries:
    - id: 3
      speakerName: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
      dialogueText: "\uC57D 50\uB144 \uC804\uBD80\uD130, \uC0AC\uB78C\uC5D0\uAC8C\uC11C
        \uC124\uBA85\uD560 \uC218 \uC5C6\uB294 \uB2A5\uB825\uC774 \uBC1C\uD604\uB418\uAE30
        \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4. \uD559\uC220\uBA85\uC740 '\uC774\uC0C1\uD604\uC0C1\uC790'.
        \uC138\uAC04\uC5D0\uC11C\uB294 '\uD3F4\uD130\uAC00\uC774\uC2A4\uD2B8'\uB77C\uACE0
        \uBD80\uB974\uC8E0."
      characterIllust: {fileID: 0}
      BackGroundSprit: {fileID: 21300000, guid: 42afc4d183172ea4bb375c2b4da312d0, type: 3}
      showChatUI: 1
      EffectSound: {fileID: 0}
      seVolune: 1
      choices: []
      Char1:
        CharacterPNG: {fileID: 0}
        CharacterPos: {x: 0, y: -100}
        CharacterScale: 1
        CharacterRotation: 0
        moveDuration: 0.5
      Char2:
        CharacterPNG: {fileID: 0}
        CharacterPos: {x: 0, y: -100}
        CharacterScale: 1
        CharacterRotation: 0
        moveDuration: 0.5
      nextIndexOverride: -1
      effectVideoClip: {fileID: 0}
    - id: 4
      speakerName: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
      dialogueText: "\uD604\uC7AC \uB300\uD55C\uBBFC\uAD6D \uC778\uAD6C\uC758 \uC57D
        20%\uAC00 \uB2A5\uB825\uC790\uC785\uB2C8\uB2E4. \uBC1C\uD604\uC740 \uD3C9\uADE0
        15\uC138 \uBB34\uB835\uC774\uACE0, 18\uC138 \uC774\uD6C4\uC5D0 \uBC1C\uD604\uB41C
        \uC0AC\uB840\uB294 \uC544\uC9C1 \uC5C6\uC2B5\uB2C8\uB2E4."
      characterIllust: {fileID: 0}
      BackGroundSprit: {fileID: 21300000, guid: 42afc4d183172ea4bb375c2b4da312d0, type: 3}
      showChatUI: 1
      EffectSound: {fileID: 0}
      seVolune: 1
      choices: []
      Char1:
        CharacterPNG: {fileID: 0}
        CharacterPos: {x: 0, y: -100}
        CharacterScale: 1
        CharacterRotation: 0
        moveDuration: 0.5
      Char2:
        CharacterPNG: {fileID: 0}
        CharacterPos: {x: 0, y: -100}
        CharacterScale: 1
        CharacterRotation: 0
        moveDuration: 0.5
      nextIndexOverride: -1
      effectVideoClip: {fileID: 0}
    - id: 5
      speakerName: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
      dialogueText: "\uB2A5\uB825\uC790\uB294 \uB2A5\uB825\uC790\uBD84\uB958\uAD6D\uC5D0
        \uB4F1\uB85D\uD560 \uC758\uBB34\uAC00 \uC788\uC2B5\uB2C8\uB2E4. \uB4F1\uB85D\uD558\uC9C0
        \uC54A\uC73C\uBA74 \uCE74\uB4DC \uBC1C\uAE09\uB3C4, \uD734\uB300\uD3F0 \uAC1C\uD1B5\uB3C4
        \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
      characterIllust: {fileID: 0}
      BackGroundSprit: {fileID: 21300000, guid: 42afc4d183172ea4bb375c2b4da312d0, type: 3}
      showChatUI: 1
      EffectSound: {fileID: 0}
      seVolune: 1
      choices: []
      Char1:
        CharacterPNG: {fileID: 0}
        CharacterPos: {x: 0, y: -100}
        CharacterScale: 1
        CharacterRotation: 0
        moveDuration: 0.5
      Char2:
        CharacterPNG: {fileID: 0}
        CharacterPos: {x: 0, y: -100}
        CharacterScale: 1
        CharacterRotation: 0
        moveDuration: 0.5
      nextIndexOverride: -1
      effectVideoClip: {fileID: 0}
    - id: 6
      speakerName: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
      dialogueText: "\uADF8\uB9AC\uACE0 \uB2A5\uB825\uC774 \uC5BD\uD78C \uC0AC\uAC74\uC744
        \uC870\uC0AC\uD558\uACE0, \uB2A5\uB825\uC790\uB97C \uBCF4\uD638\uD558\uACE0,
        \uD604\uC7A5\uC5D0 \uB300\uC751\uD558\uB294 \uAE30\uAD00. \uADF8\uAC8C \uC800\uD76C
        \uC774\uC0C1\uAD00\uB9AC\uAD6D, AMA\uC785\uB2C8\uB2E4."
      characterIllust: {fileID: 0}
      BackGroundSprit: {fileID: 21300000, guid: 42afc4d183172ea4bb375c2b4da312d0, type: 3}
      showChatUI: 1
      EffectSound: {fileID: 0}
      seVolune: 1
