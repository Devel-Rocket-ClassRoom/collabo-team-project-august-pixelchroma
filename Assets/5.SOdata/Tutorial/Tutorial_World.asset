      effectVideoClip: {fileID: 0}
    - id: 10
      speakerName: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
      dialogueText: "\uAD6D\uC7A5\uB2D8\uC740 \uBE44\uB2A5\uB825\uC790\uC2DC\uB2C8
        \uC9C1\uC811 \uC2F8\uC6B0\uC2E4 \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.
        \uD310\uB2E8\uD558\uACE0, \uBC30\uCE58\uD558\uACE0, \uC9C0\uD718\uD558\uB294
        \uAC83. \uADF8\uAC8C \uAD6D\uC7A5\uB2D8\uC758 \uC77C\uC785\uB2C8\uB2E4."
      characterIllust: {fileID: 0}
