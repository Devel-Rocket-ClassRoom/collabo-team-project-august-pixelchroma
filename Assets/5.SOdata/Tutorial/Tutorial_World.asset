      effectVideoClip: {fileID: 0}
    - id: 7
      speakerName: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
      dialogueText: "\uB300\uD1B5\uB839 \uC9C1\uC18D CSIA\uC640\uB294 \uD611\uC5C5
        \uAD00\uACC4\uC785\uB2C8\uB2E4. \u2026\uD45C\uBA74\uC0C1\uC73C\uB85C\uB294\uC694.
        \uADF8\uCABD \uC0AC\uB78C\uB4E4\uC740 \uC870\uC2EC\uD558\uC2DC\uB294 \uD3B8\uC774
        \uC88B\uC2B5\uB2C8\uB2E4."
      characterIllust: {fileID: 0}
      BackGroundSprit: {fileID: 21300000, guid: 42afc4d183172ea4bb375c2b4da312d0, type: 3}
