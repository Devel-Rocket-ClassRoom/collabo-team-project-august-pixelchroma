%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 39e03c11d26e8c445a9a71ccf44b4d92, type: 3}
  m_Name: Tutorial_BattleGuide
  m_EditorClassIdentifier: Assembly-CSharp::TutorialGuideData
  speakerPortrait: {fileID: 0}
  steps:
  - speaker: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
    text: "\uC5EC\uAE30\uB294 AMA \uBAA8\uC758 \uC804\uC220 \uD6C8\uB828\uC7A5\uC785\uB2C8\uB2E4.
      \uC9C0\uD718\uB294 \uC804\uBD80 \uC190\uAC00\uB77D \uD558\uB098\uB85C \uD560
      \uC218 \uC788\uAC8C \uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
    goal: 0
    objective: 
  - speaker: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
    text: "\uBA3C\uC800 \uC694\uC6D0\uC744 \uBC30\uCE58\uD569\uB2C8\uB2E4. \uC544\uB798
      \uBAA9\uB85D\uC5D0\uC11C \uC694\uC6D0\uC744 \uACE0\uB974\uACE0, \uD30C\uB797\uAC8C
      \uBE5B\uB098\uB294 \uBC30\uCE58 \uAD6C\uC5ED\uC744 \uB20C\uB7EC \uC138\uC6B0\uC138\uC694.
      \uB2E4 \uC138\uC6E0\uC73C\uBA74 '\uC791\uC804 \uAC1C\uC2DC'\uB97C \uB204\uB974\uC2DC\uBA74
      \uB429\uB2C8\uB2E4."
    goal: 1
    objective: "\uC694\uC6D0\uC744 \uBC30\uCE58\uD558\uACE0 \uC791\uC804\uC744 \uAC1C\uC2DC\uD558\uC138\uC694"
  - speaker: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
    text: "\uC791\uC804 \uC2DC\uC791\uC785\uB2C8\uB2E4. \uC544\uAD70 \uC694\uC6D0\uC744
      \uB20C\uB7EC \uBCF4\uC138\uC694. \uD30C\uB780 \uCE78\uC740 \uC774\uB3D9\uD560
      \uC218 \uC788\uB294 \uACF3, \uBE68\uAC04 \uCE78\uC740 \uACF5\uACA9\uC774 \uB2FF\uB294
      \uACF3\uC785\uB2C8\uB2E4."
    goal: 2
    objective: "\uC544\uAD70 \uC694\uC6D0\uC744 \uC120\uD0DD\uD558\uC138\uC694"
  - speaker: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
    text: "\uD30C\uB780 \uCE78 \uC911 \uD55C \uACF3\uC744 \uB20C\uB7EC \uC774\uB3D9\uD558\uC138\uC694.
      \uC798\uBABB \uC6C0\uC9C1\uC600\uB2E4\uBA74 \uD589\uB3D9\uC744 \uD655\uC815\uD558\uAE30
      \uC804\uAE4C\uC9C0 '\uB418\uB3CC\uB9AC\uAE30'\uB85C \uCDE8\uC18C\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    goal: 3
    objective: "\uD30C\uB780 \uCE78\uC744 \uB20C\uB7EC \uC774\uB3D9\uD558\uC138\uC694"
  - speaker: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
    text: "\uC774\uC81C \uACF5\uACA9\uC785\uB2C8\uB2E4. \uBE68\uAC04 \uCE78 \uC548\uC758
      \uC801\uC744 \uB204\uB974\uBA74 \uC608\uC0C1 \uD53C\uD574, \uBA85\uC911\uB960,
      \uBC18\uACA9 \uC5EC\uBD80\uAC00 \uBA3C\uC800 \uD45C\uC2DC\uB429\uB2C8\uB2E4.
      \uD655\uC778\uD558\uACE0 \uACF5\uACA9\uD558\uC138\uC694."
    goal: 4
    objective: "\uC801\uC744 \uB20C\uB7EC \uC608\uCE21\uC744 \uD655\uC778\uD558\uACE0
      \uACF5\uACA9\uD558\uC138\uC694"
  - speaker: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
    text: "\uACF5\uACA9\uBC1B\uC740 \uC801\uC774 \uC0B4\uC544\uB0A8\uACE0 \uC0AC\uAC70\uB9AC\uAC00
      \uB2FF\uC73C\uBA74 \uBC18\uACA9\uD569\uB2C8\uB2E4. \uACF5\uACA9\uD558\uAE30
      \uC804\uC5D0 \uC608\uCE21 \uCC3D\uC5D0\uC11C \uBC18\uACA9 \uC5EC\uBD80\uB97C
      \uAF2D \uD655\uC778\uD558\uC138\uC694. \uC801\uC5D0\uAC8C \uACF5\uACA9\uBC1B\uC740
      \uC694\uC6D0\uB3C4 \uB611\uAC19\uC774 \uBC18\uACA9\uD569\uB2C8\uB2E4."
    goal: 0
    objective: 
  - speaker: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
    text: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uAC00\uC7A5 \uC911\uC694\uD55C \uAC83.
      \uC67C\uCABD \uC704 '\uC704\uD611 \uBC94\uC704' \uBC84\uD2BC\uC744 \uB20C\uB7EC
      \uBCF4\uC138\uC694. \uC801\uC774 \uB2E4\uC74C \uD134\uC5D0 \uACF5\uACA9\uD560
      \uC218 \uC788\uB294 \uCE78\uC774 \uBD89\uAC8C \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    goal: 5
    objective: "\uC704\uD611 \uBC94\uC704 \uBC84\uD2BC\uC744 \uB204\uB974\uC138\uC694"
  - speaker: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
    text: "\uBD89\uC740 \uCE78\uC774 \uC9D9\uC744\uC218\uB85D \uC5EC\uB7EC \uC801\uC774
      \uB178\uB9AC\uB294 \uC790\uB9AC\uC785\uB2C8\uB2E4. \uC694\uC6D0\uC744 \uBD89\uC740
      \uCE78 \uBC16\uC774\uB098 \uC5C4\uD3D0\uBB3C \uB4A4\uC5D0 \uC138\uC6B0\uB294
      \uAC8C \uAE30\uBCF8\uC785\uB2C8\uB2E4."
    goal: 0
    objective: 
  - speaker: "\uD0A4\uD0C0\uB178 \uC720\uD0A4"
    text: "\uD589\uB3D9\uC744 \uB9C8\uCE5C \uC694\uC6D0\uC740 \uD68C\uC0C9\uC774
      \uB418\uACE0, \uBAA8\uB450 \uD589\uB3D9\uD558\uBA74 \uC801\uC758 \uD134\uC774
      \uB429\uB2C8\uB2E4. \uD6C8\uB828 \uBAA9\uD45C\uB294 \uC801 \uC804\uBA78. \uC2E4\uC804\uCC98\uB7FC
      \uC9C0\uD718\uD574 \uBCF4\uC2DC\uC8E0."
    goal: 6
    objective: "\uC801\uC744 \uBAA8\uB450 \uC4F0\uB7EC\uB728\uB9AC\uC138\uC694"
  victoryText: "\uD6C8\uB828 \uC885\uB8CC. \uCCAB \uC9C0\uD718\uCE58\uACE0\uB294
    \uB098\uC058\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4, \uAD6D\uC7A5\uB2D8. \uC2E4\uC804\uB3C4
    \uC774 \uAC10\uAC01\uC73C\uB85C \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4."
  defeatText: "\uAD1C\uCC2E\uC2B5\uB2C8\uB2E4. \uBAA8\uC758 \uD6C8\uB828\uC774\uB2C8\uAE4C\uC694.
    \uC704\uD611 \uBC94\uC704\uB97C \uD655\uC778\uD558\uBA74\uC11C \uB2E4\uC2DC \uD574
    \uBCF4\uC2DC\uC8E0."
